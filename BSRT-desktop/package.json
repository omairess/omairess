{
  "name": "bsrt",
  "productName": "BSRT",
  "version": "1.0.0",
  "description": "Behavioral Sleep Resistance Task \u2014 OSLER paradigm with frame-locked timing",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win",
    "check:shared": "node -e \"const fs=require('fs');const files=['scoring.js','i18n.js','participants.js'];let bad=0;for(const f of files){const a=fs.readFileSync('renderer/'+f);const b=fs.readFileSync('../BSRT/'+f);if(a.equals(b))console.log('ok  '+f+' identical in both builds');else{console.error('FAIL '+f+' has diverged \u2014 copy one over the other');bad++}}process.exit(bad?1:0)\"",
    "check:scoring": "npm run check:shared"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.bsrt.osler",
    "productName": "BSRT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
