{
  "name": "bsrt",
  "productName": "BSRT",
  "version": "1.0.0",
  "description": "Behavioral Sleep Resistance Task \u2014 OSLER paradigm with frame-locked timing",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --mac --win",
    "check:scoring": "node -e \"const a=require('fs').readFileSync('renderer/scoring.js');const b=require('fs').readFileSync('../BSRT/scoring.js');if(!a.equals(b)){console.error('scoring.js copies have diverged \u2014 copy one over the other');process.exit(1)}console.log('scoring.js copies identical')\""
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.bsrt.osler",
    "productName": "BSRT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
